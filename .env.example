# Shared Timescale + Ably keys = one worldwide queue. A second laptop
# with these same values sits in the same Hands Up / SNG lines.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
ABLY_ROOT_KEY=
ABLY_SUBSCRIBE_KEY=
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5176
# Leave empty on Vercel so the site calls /api on the same host.
# http://127.0.0.1:4000 makes a phone on another network call itself.
# Vercel runtime also needs DATABASE_URL, ABLY_ROOT_KEY, ABLY_SUBSCRIBE_KEY,
# SOLANA_RPC_URL, ELO_PROGRAM_ID, ACHIEVEMENT_PROGRAM_ID, SOLANA_AUTHORITY_SECRET.
VITE_API_URL=
# Optional subscribe-only key so a browser can still hear Ably if /api/ably/token is down.
VITE_ABLY_SUBSCRIBE_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
ELO_PROGRAM_ID=9KXCrZkohvdxYUvKU9kusUcBCdj1JB1NFUoYgFbdnWS2
ACHIEVEMENT_PROGRAM_ID=5edqME6uP35tWd8Wt47UMEND9EzwnTPWcqY7CyGk554F
SOLANA_AUTHORITY_SECRET=

# --- Solana ranked Elo (horns_elo program on devnet) ---
# SOLANA_RPC=https://api.devnet.solana.com
# SERVER_KEYPAIR=~/.config/solana/horns-elo-server.json   (game server key; without it matches are unrated)
# --- AI coach (Meta Muse) ---
MODEL_API_KEY=
# --- AI practice opponents + play-style data (Snowflake; run server/snowflake/setup.sql) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
# AI_PRACTICE_PER_DAY=5
# --- Poker news ticker + coach web search (SerpApi) ---
SERPAPI_KEY=
