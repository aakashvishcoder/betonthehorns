{
  "name": "betonthehorns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "format": "prettier --write src index.html vite.config.ts",
    "test:server": "DATABASE_URL=postgres://test@127.0.0.1:1/none ABLY_ROOT_KEY=test.test:test SNOWFLAKE_ACCOUNT= SNOWFLAKE_PAT= MODEL_API_KEY= SERPAPI_KEY= tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tooltip": "1.2.8",
    "@solana/web3.js": "^1.98.4",
    "@vgpu/wgsl": "0.6.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "ably": "^2.30.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "framer-motion": "^11.11.11",
    "lenis": "1.3.27",
    "lucide-react": "0.453.0",
    "next-themes": "0.4.6",
    "pg": "^8.23.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "vgpu": "0.6.0",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.5",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
