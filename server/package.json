{
  "name": "betonthehorns-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test --test-timeout=60000 \"src/**/*.test.ts\"",
    "test:devnet": "node --test src/devnet.e2e.ts",
    "check": "tsc -p src",
    "prototype": "node --env-file-if-exists=.env src/prototype.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "ws": "^8.22.0"
  }
}
