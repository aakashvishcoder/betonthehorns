{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  // server/src is the WebSocket game server (coach, news, AI practice, Solana Elo); it has its own tsconfig.
  "exclude": ["src", "node_modules", ".cache"]
}
