# Copy this file to server/.env and fill it in. server/.env is git-ignored.
# Muse (Meta Model API) key from https://dev.meta.ai — used only by the server's /api/coach endpoint.
MODEL_API_KEY=
# Optional: model for the coach (default muse-spark-1.3, Standard tier: chats are not used for training).
# MUSE_MODEL=muse-spark-1.3

# Snowflake (AI practice opponents + player style data). Run server/snowflake/setup.sql first; it prints both values.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
# Optional overrides (defaults match setup.sql):
# SNOWFLAKE_WAREHOUSE=HORNS_WH
# SNOWFLAKE_DATABASE=HORNS
# SNOWFLAKE_SCHEMA=POKER
# SNOWFLAKE_ROLE=HORNS_APP
# CORTEX_MODEL_SHARK=claude-haiku-4-5
# CORTEX_MODEL_MANIAC=openai-gpt-5-nano
# CORTEX_MODEL_ROCK=llama3.1-8b
